<mjml>
  <mj-body>
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" font-weight="bold">Email confirmation</mj-text>
        <mj-text>Hello {{ username }}, click the link below to confirm your email:</mj-text>
        <mj-button href="{{ confirm_url }}" background-color="#4F46E5">
          Confirm email 
        </mj-button>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>